# Supabase — Project Settings → API Keys (ou `npx supabase status -o env` en local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé de service : serveur uniquement, ne jamais l'exposer au navigateur.
SUPABASE_SECRET_KEY=
# Facultatif : adresses autorisées à recevoir un lien de connexion (séparées par des virgules).
APP_OWNER_EMAILS=
